{
  "name": "@dancommitsgit/openai-mcp",
  "version": "1.2.0",
  "description": "MCP server that gives Claude, Cursor and other MCP clients access to OpenAI text, image, speech, transcription, embeddings and moderation",
  "bin": {
    "openai-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanCommitsGit/openai-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "openai",
    "chatgpt",
    "gpt",
    "claude",
    "cursor",
    "image-generation",
    "text-to-speech",
    "speech-to-text",
    "whisper",
    "embeddings",
    "moderation"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DanCommitsGit/openai-mcp/issues"
  },
  "homepage": "https://github.com/DanCommitsGit/openai-mcp#readme",
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "openai": "^7.15.0",
    "zod": "^4.6.4"
  }
}
